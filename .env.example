# Copy to .env and fill in, or set these in the Vercel project settings.
# Only the contact endpoint reads them; every other route is static and needs nothing.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=ndegwak6@gmail.com

# Optional. Defaults to Resend's shared sender, which works immediately but
# lands in spam more often. Set this to an address on a domain verified in
# Resend before treating the form as production.
CONTACT_FROM_EMAIL=hello@example.com
