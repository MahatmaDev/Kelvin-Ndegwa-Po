---
/**
 * 404.
 *
 * A dead end is a bad place to leave someone who was interested enough to
 * follow a link, so this page offers the three destinations that actually
 * matter rather than a joke and a back button.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { PROFILE } from '@data/site';

const DESTINATIONS = [
  { href: '/work/', label: 'Case studies', detail: 'How the systems are actually built' },
  { href: '/writing/', label: 'Writing', detail: 'Teardowns and debugging stories' },
  { href: '/#contact', label: 'Contact', detail: 'The fastest way to reach me' },
] as const;
---

<BaseLayout title="Not found" description="That page does not exist." noindex padded>
  <div class="container container--prose">
    <p class="code">404</p>
    <h1>That page does not exist.</h1>
    <p class="lede">
      Either the link is wrong or I moved something during the rebuild. Both are my fault. Here
      is where you were probably heading:
    </p>

    <ul class="destinations" role="list">
      {
        DESTINATIONS.map((destination) => (
          <li>
            <a href={destination.href}>
              <span>
                <span class="destinations__label">{destination.label}</span>
                <span class="destinations__detail">{destination.detail}</span>
              </span>
              <Icon name="arrow-right" size={17} />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="fallback">
      If you followed a link from somewhere and it broke, tell me where it was —
      <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .code {
    font-family: var(--font-mono);
    font-size: var(--step-2);
    letter-spacing: var(--tracking-caps);
    color: var(--text-accent);
  }

  h1 {
    margin-block-start: var(--space-s);
    font-size: var(--step-4);
  }

  .lede {
    margin-block-start: var(--space-m);
    color: var(--text-secondary);
  }

  .destinations {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    margin-block-start: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .destinations a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-m);
    background-color: var(--surface-raised);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .destinations a:hover {
    border-color: var(--border-accent);
    color: var(--text-accent);
  }

  .destinations__label {
    display: block;
    font-weight: var(--weight-medium);
  }

  .destinations__detail {
    display: block;
    font-size: var(--step--1);
    color: var(--text-tertiary);
  }

  .fallback {
    margin-block-start: var(--space-l);
    font-size: var(--step--1);
    color: var(--text-tertiary);
  }
</style>
