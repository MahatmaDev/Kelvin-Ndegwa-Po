---
/**
 * Contact.
 *
 * Two routes offered deliberately: a form for people who want a form, and a
 * plain address for people who would rather not type into someone else's
 * text box. Both reach the same inbox. Making the visitor choose between
 * "form" and "no way to reach you" loses the visitor.
 */
import { PROFILE, SOCIALS, AVAILABILITY } from '@data/site';
import ContactForm from '@components/islands/ContactForm.tsx';
import Icon from '@components/ui/Icon.astro';

const links = SOCIALS.filter((social) => social.icon !== 'email');
---

<section id="contact" class="section" aria-labelledby="contact-heading">
  <div class="container container--wide">
    <div class="contact">
      <div class="contact__intro">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-heading">Tell me what you are building.</h2>

        <p class="contact__lede">{AVAILABILITY.detail}</p>

        <ul class="contact__direct" role="list">
          <li>
            <a href={`mailto:${PROFILE.email}`}>
              <Icon name="email" size={17} />
              <span>
                <span class="contact__direct-label">Email</span>
                <span class="contact__direct-value">{PROFILE.email}</span>
              </span>
            </a>
          </li>
          {
            links.map((social) => (
              <li>
                <a
                  href={social.href}
                  rel={social.href.startsWith('http') ? 'me noopener' : undefined}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                >
                  <Icon name={social.icon} size={17} />
                  <span>
                    <span class="contact__direct-label">{social.label}</span>
                    <span class="contact__direct-value">
                      {social.href.replace(/^https?:\/\/(www\.)?/, '')}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="contact__timezone">
          <Icon name="command" size={14} />
          I am in {PROFILE.timezone}. Replies usually land within a working day.
        </p>
      </div>

      <div class="contact__form">
        <ContactForm client:visible />

        {/* Rendered for everyone; only meaningful before hydration. */}
        <noscript>
          <p class="contact__noscript">
            This form works without JavaScript — it will submit normally and show a plain
            confirmation page. Or email <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>.
          </p>
        </noscript>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 56rem) {
    .contact {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }

  .contact__intro h2 {
    margin-block-start: var(--space-2xs);
  }

  .contact__lede {
    margin-block-start: var(--space-s);
    max-inline-size: 44ch;
    color: var(--text-secondary);
  }

  .contact__direct {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    margin-block-start: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .contact__direct a {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-m);
    background-color: var(--surface-raised);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .contact__direct a:hover {
    border-color: var(--border-accent);
    color: var(--text-accent);
  }

  .contact__direct-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .contact__direct-value {
    display: block;
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    overflow-wrap: anywhere;
  }

  .contact__timezone {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
    font-size: var(--step--2);
    color: var(--text-tertiary);
  }

  .contact__form {
    padding: var(--space-m);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-l);
    background-color: var(--surface-raised);
  }

  .contact__noscript {
    margin-block-start: var(--space-s);
    font-size: var(--step--1);
    color: var(--text-tertiary);
  }
</style>
