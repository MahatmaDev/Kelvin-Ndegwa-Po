---
/**
 * Callout — an aside inside long-form MDX.
 *
 * The `draft` variant is deliberately loud. It marks a case study whose
 * numbers have not yet been confirmed against the real system, so that an
 * unverified claim cannot quietly reach a reader who might check it.
 */
import Icon, { type IconName } from '@components/ui/Icon.astro';

interface Props {
  variant?: 'note' | 'decision' | 'warning' | 'draft';
  title?: string;
}

const { variant = 'note', title } = Astro.props;

const PRESETS: Record<NonNullable<Props['variant']>, { icon: IconName; label: string }> = {
  note: { icon: 'command', label: 'Note' },
  decision: { icon: 'check', label: 'Decision' },
  warning: { icon: 'external', label: 'Caveat' },
  draft: { icon: 'search', label: 'Unverified — pending confirmation' },
};

const preset = PRESETS[variant];
---

<aside class:list={['callout', `callout--${variant}`]}>
  <p class="callout__label">
    <Icon name={preset.icon} size={15} />
    {title ?? preset.label}
  </p>
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    margin-block: var(--space-m);
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius-m);
    border: 1px solid var(--border-subtle);
    border-inline-start: 3px solid var(--border-strong);
    background-color: var(--surface-raised);
    font-size: var(--step--1);
  }

  .callout__label {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .callout__body > :global(* + *) {
    margin-block-start: var(--space-xs);
  }

  .callout--decision {
    border-inline-start-color: var(--accent);
  }

  .callout--decision .callout__label {
    color: var(--text-accent);
  }

  .callout--warning {
    border-inline-start-color: var(--c-warning);
  }

  .callout--warning .callout__label {
    color: var(--c-warning);
  }

  .callout--draft {
    border-inline-start-color: var(--c-danger);
    background-color: color-mix(in oklab, var(--c-danger) 8%, var(--surface-raised));
  }

  .callout--draft .callout__label {
    color: var(--c-danger);
  }
</style>
