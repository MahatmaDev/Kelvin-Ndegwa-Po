---
/**
 * Button / link primitive.
 *
 * Renders an <a> when given an href and a <button> otherwise — the correct
 * element for the job, rather than a div with a click handler. Navigation
 * must remain keyboard-operable, middle-clickable and open-in-new-tab-able.
 */
import Icon, { type IconName } from '@components/ui/Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  download?: boolean | string;
  class?: string;
  'aria-label'?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'end',
  type = 'button',
  disabled = false,
  download,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

/* External links need the security rel and a new tab; internal ones must not. */
const isExternal = typeof href === 'string' && /^https?:\/\//.test(href);

const linkProps = href
  ? {
      href,
      download,
      ...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
    }
  : { type, disabled };

const iconSize = size === 'lg' ? 20 : size === 'sm' ? 15 : 17;
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...linkProps}
  {...rest}
>
  {icon && iconPosition === 'start' && <Icon name={icon} size={iconSize} class="btn__icon" />}
  <span class="btn__label"><slot /></span>
  {icon && iconPosition === 'end' && <Icon name={icon} size={iconSize} class="btn__icon" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    border-radius: var(--radius-m);
    font-weight: var(--weight-medium);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn:not(:disabled):active {
    transform: translateY(1px);
  }

  /* ── Sizes ─────────────────────────────────────────────────────────── */

  .btn--sm {
    padding: var(--space-3xs) var(--space-xs);
    font-size: var(--step--1);
  }

  .btn--md {
    padding: var(--space-2xs) var(--space-s);
    font-size: var(--step--1);
    min-block-size: 2.5rem;
  }

  .btn--lg {
    padding: var(--space-xs) var(--space-m);
    font-size: var(--step-0);
    min-block-size: 3rem;
  }

  /* ── Variants ──────────────────────────────────────────────────────── */

  .btn--primary {
    background-color: var(--accent);
    color: var(--on-accent);
    font-weight: var(--weight-semibold);
  }

  .btn--primary:hover:not(:disabled) {
    background-color: var(--accent-hover);
    color: var(--on-accent);
    box-shadow: var(--shadow-glow);
  }

  .btn--secondary {
    background-color: var(--surface-raised);
    border-color: var(--border-default);
    color: var(--text-primary);
  }

  .btn--secondary:hover:not(:disabled) {
    border-color: var(--border-strong);
    background-color: var(--surface-overlay);
    color: var(--text-primary);
  }

  .btn--ghost {
    color: var(--text-secondary);
  }

  .btn--ghost:hover:not(:disabled) {
    color: var(--text-primary);
    background-color: var(--surface-raised);
  }

  /* Nudge the trailing arrow on hover — a small affordance that the
     control leads somewhere. */
  .btn__icon {
    transition: transform var(--duration-base) var(--ease-spring);
  }

  .btn:hover .btn__icon {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover .btn__icon {
      transform: none;
    }
  }
</style>
